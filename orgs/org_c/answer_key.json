{
  "org": "org_c",
  "planted": [
    "Opportunity.StageName uses the org's own stage names, not the target's.",
    "'Verbal Commit' is a retired stage: inactive in the picklist, still on records.",
    "Account.Industry_Text__c is free text with inconsistent spelling, case and spacing.",
    "Account.Tier__c uses Gold/Silver/Bronze.",
    "Task.Kind__c is free text standing in for the activity type."
  ],
  "mappings": [
    {
      "target": "accounts.external_id",
      "source": "Account.Id",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "accounts.name",
      "source": "Account.Name",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "accounts.industry",
      "source": "Account.Industry_Text__c",
      "must_ask": false,
      "may_ask": false,
      "rule": "trim; optionally normalize spelling"
    },
    {
      "target": "accounts.tier",
      "source": "Account.Tier__c",
      "must_ask": true,
      "may_ask": false,
      "rule": "map values Gold/Silver/Bronze",
      "note": "Nothing in the org says which metal is which tier."
    },
    {
      "target": "accounts.website",
      "source": "Account.Website",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "accounts.customer_since",
      "source": null,
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "accounts.owner_email",
      "source": null,
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "contacts.external_id",
      "source": "Contact.Id",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "contacts.account_external_id",
      "source": "Contact.AccountId",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "contacts.first_name",
      "source": "Contact.FirstName",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "contacts.last_name",
      "source": "Contact.LastName",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "contacts.email",
      "source": "Contact.Email",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "contacts.phone",
      "source": "Contact.Phone",
      "must_ask": false,
      "may_ask": false,
      "rule": "normalize to E.164"
    },
    {
      "target": "contacts.role",
      "source": null,
      "must_ask": false,
      "may_ask": false,
      "rule": "copy",
      "note": "Contact.Title is a job title, not a buying role."
    },
    {
      "target": "deals.external_id",
      "source": "Opportunity.Id",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "deals.account_external_id",
      "source": "Opportunity.AccountId",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "deals.name",
      "source": "Opportunity.Name",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "deals.amount",
      "source": "Opportunity.Amount",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "deals.currency",
      "source": null,
      "must_ask": false,
      "may_ask": true,
      "rule": "default USD",
      "note": "No currency field; confirming the USD default is reasonable."
    },
    {
      "target": "deals.stage",
      "source": "Opportunity.StageName",
      "must_ask": true,
      "may_ask": false,
      "rule": "map values",
      "note": "'Verbal Commit' is retired and has no clear target stage."
    },
    {
      "target": "deals.close_date",
      "source": "Opportunity.CloseDate",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "deals.owner_email",
      "source": null,
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "activities.external_id",
      "source": "Task.Id",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "activities.related_type",
      "source": "Task.WhatId",
      "must_ask": false,
      "may_ask": false,
      "rule": "lookup on the record Id prefix"
    },
    {
      "target": "activities.related_external_id",
      "source": "Task.WhatId",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "activities.kind",
      "source": "Task.Kind__c",
      "must_ask": false,
      "may_ask": false,
      "rule": "map values across spellings"
    },
    {
      "target": "activities.subject",
      "source": "Task.Subject",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    },
    {
      "target": "activities.occurred_at",
      "source": "Task.ActivityDate",
      "must_ask": false,
      "may_ask": true,
      "rule": "cast date to timestamp",
      "note": "A due date with no time, on tasks that may not have happened yet."
    },
    {
      "target": "activities.notes",
      "source": "Task.Description",
      "must_ask": false,
      "may_ask": false,
      "rule": "copy"
    }
  ]
}
