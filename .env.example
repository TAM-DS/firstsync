# Copy to .env and fill in. Never commit .env.
# The scripts read .env; variables already set in your shell take precedence.

# Claude (used by scripts/describe_org.py through the Claude Agent SDK)
ANTHROPIC_API_KEY=
FIRSTSYNC_MODEL=claude-sonnet-5-5

# Live Salesforce connection (development only; the portal's OAuth flow replaces this in week 4).
# The MCP tools never receive these values. They take a connection handle ("live") instead.
SF_INSTANCE_URL=https://your-domain.develop.my.salesforce.com
SF_ACCESS_TOKEN=
SF_API_VERSION=v62.0

# Where tool calls are logged
FIRSTSYNC_AUDIT_LOG=.firstsync/audit.jsonl
