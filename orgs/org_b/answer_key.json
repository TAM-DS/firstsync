{
  "org": "org_b",
  "planted": [
    "Account.Field_7__c holds the industry under an unhelpful name.",
    "Account.Acct_Tier__c uses T1/T2/T3 for enterprise/standard/free.",
    "Account.Site, a standard field, holds the customer-since date as MM/DD/YYYY text.",
    "Contact.Department, a standard field, holds the buying role.",
    "Deal__c, a custom object, stands in for Opportunity.",
    "Deal__c.Deal_Phase__c has a value, 'Legal Hold', with no matching target stage."
  ],
  "mappings": [
    {
      "target": "accounts.external_id",
      "source": "Account.Id",
      "rule": "copy"
    },
    {
      "target": "accounts.name",
      "source": "Account.Name",
      "rule": "copy"
    },
    {
      "target": "accounts.industry",
      "source": "Account.Field_7__c",
      "rule": "copy"
    },
    {
      "target": "accounts.tier",
      "source": "Account.Acct_Tier__c",
      "rule": "map values T1/T2/T3"
    },
    {
      "target": "accounts.website",
      "source": "Account.Website",
      "rule": "copy"
    },
    {
      "target": "accounts.customer_since",
      "source": "Account.Site",
      "rule": "parse date MM/DD/YYYY"
    },
    {
      "target": "accounts.owner_email",
      "source": null,
      "rule": "copy"
    },
    {
      "target": "contacts.external_id",
      "source": "Contact.Id",
      "rule": "copy"
    },
    {
      "target": "contacts.account_external_id",
      "source": "Contact.AccountId",
      "rule": "copy"
    },
    {
      "target": "contacts.first_name",
      "source": "Contact.FirstName",
      "rule": "copy"
    },
    {
      "target": "contacts.last_name",
      "source": "Contact.LastName",
      "rule": "copy"
    },
    {
      "target": "contacts.email",
      "source": "Contact.Email",
      "rule": "copy"
    },
    {
      "target": "contacts.phone",
      "source": "Contact.Phone",
      "rule": "normalize to E.164"
    },
    {
      "target": "contacts.role",
      "source": "Contact.Department",
      "rule": "map values"
    },
    {
      "target": "deals.external_id",
      "source": "Deal__c.Id",
      "rule": "copy"
    },
    {
      "target": "deals.account_external_id",
      "source": "Deal__c.Account__c",
      "rule": "copy"
    },
    {
      "target": "deals.name",
      "source": "Deal__c.Name",
      "rule": "copy"
    },
    {
      "target": "deals.amount",
      "source": "Deal__c.Amt__c",
      "rule": "copy"
    },
    {
      "target": "deals.currency",
      "source": null,
      "rule": "default USD"
    },
    {
      "target": "deals.stage",
      "source": "Deal__c.Deal_Phase__c",
      "rule": "map values",
      "note": "'Legal Hold' has no match; the admin must be asked."
    },
    {
      "target": "deals.close_date",
      "source": "Deal__c.Close_Dt__c",
      "rule": "copy"
    },
    {
      "target": "deals.owner_email",
      "source": "Deal__c.Owner_Email__c",
      "rule": "copy"
    },
    {
      "target": "activities.external_id",
      "source": "Task.Id",
      "rule": "copy"
    },
    {
      "target": "activities.related_type",
      "source": "Task.WhatId",
      "rule": "derive from the referenced object"
    },
    {
      "target": "activities.related_external_id",
      "source": "Task.WhatId",
      "rule": "copy"
    },
    {
      "target": "activities.kind",
      "source": "Task.Type",
      "rule": "map values; 'Other' becomes 'task'"
    },
    {
      "target": "activities.subject",
      "source": "Task.Subject",
      "rule": "copy"
    },
    {
      "target": "activities.occurred_at",
      "source": "Task.ActivityDate",
      "rule": "date to timestamp"
    },
    {
      "target": "activities.notes",
      "source": "Task.Description",
      "rule": "copy"
    }
  ]
}
